# ---------------------------------------------------------------------------
# BillWise AI - frontend environment template
# Copy to `.env` if you need to override the defaults.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is therefore
# PUBLIC. Never put an API key, database URL or any other secret in this file.
# The OpenAI key lives only in backend/.env.
# ---------------------------------------------------------------------------

# Identifies the seeded demo user to the backend via the X-Demo-User header.
# This is a demo convenience, not authentication.
VITE_DEMO_USER=amina@demo.billwise.ai
