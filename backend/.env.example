# ---------------------------------------------------------------------------
# BillWise AI - backend environment template
# Copy to `.env` and fill in. NEVER commit a real .env file.
# Every value here is a placeholder. No real secrets belong in this file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL (recommended):
#   DATABASE_URL=postgresql+psycopg://billwise:CHANGE_ME@localhost:5432/billwise
# SQLite (zero-setup local development, this is the default):
DATABASE_URL=sqlite:///./billwise.db

# --- LLM provider ---------------------------------------------------------
# Backend-only. Never send this to the browser.
# Leave blank to run the assistant in deterministic offline mode.
#
# Official OpenAI key (sk-... / sk-proj-...):
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#
# OpenRouter key (sk-or-v1-...): auto-detects and uses https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_MODEL=gpt-4o-mini
#   (resolved as openai/gpt-4o-mini on OpenRouter)
#
# Optional override:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=30

# --- AI agent limits ------------------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=8
AI_RATE_LIMIT_REQUESTS=15
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- App ------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo auth: the frontend sends this as the X-Demo-User header.
# This is NOT real authentication; it scopes queries to one seeded demo user.
DEMO_USER_EMAIL=amina@demo.billwise.ai
SEED_ON_STARTUP=true
